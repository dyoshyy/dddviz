{
  "name": "dddviz-web",
  "private": true,
  "description": "Rendering code for dddviz. Built output is committed; consumers never need Node.",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --minify --format=iife --target=es2019 --outfile=../internal/render/assets/app.js --legal-comments=none",
    "dev": "esbuild src/app.ts --bundle --format=iife --target=es2019 --outfile=../internal/render/assets/app.js --sourcemap=inline",
    "check": "tsc --noEmit",
    "shot": "esbuild scripts/shot.ts --bundle --platform=node --format=esm --outfile=.shot.mjs --packages=external && node .shot.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0"
  }
}
